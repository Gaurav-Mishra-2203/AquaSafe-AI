# AquaSafe AI Environment Configuration

# Application settings
APP_NAME="AquaSafe AI"
PORT=8000
ENVIRONMENT="development"

# AI Provider Configuration (Optional)
# Leave blank to use the built-in deterministic WHO Expert Heuristic Engine
AI_PROVIDER="auto" # Options: auto, gemini, openai, groq

# Google Gemini API Key (Optional)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=""

# OpenAI API Key (Optional)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Groq Cloud API Key (Optional)
# Get key from: https://console.groq.com/
GROQ_API_KEY=""

# Database & Model paths (defaults are relative to backend)
# DB_PATH="backend/data/aquasafe.db"
# MODEL_PATH="backend/models/water_potability_model.joblib"
